@model Front_Office_Concours_Admin.Models.AnnoncePagedViewModel
@{
    ViewData["Title"] = "Recherche d'emploi";
}

<link rel="stylesheet" href="~/css/annonces.css" asp-append-version="true" />
<!-- Bootstrap Icons pour la flèche -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container mt-4">
    
    <!-- 🔍 Formulaire de recherche -->
    <div class="search-card mb-1">
        <form method="get">
            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Titre du poste</label>
                    <input class="form-control" name="title" placeholder="Ex: Développeur, Comptable..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Lieu</label>
                    <input class="form-control" name="location" placeholder="Ex: Antananarivo, Tamatave" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Type de contrat</label>
                    <select class="form-select" name="typeContrat">
                        <option value="">Tous</option>
                        <option>CDI</option>
                        <option>CDD</option>
                        <option>Stage</option>
                        <option>Freelance</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Diplôme requis</label>
                    <select class="form-select" name="diplome">
                        <option value="">Tous</option>
                        <option>CEPE</option>
                        <option>BEPC</option>
                        <option>BACC</option>
                        <option>Licence</option>
                        <option>Master</option>
                        <option>Doctorat</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Durée de travail</label>
                    <select class="form-select" name="horaire">
                        <option value="">Tous</option>
                        <option>Temps plein</option>
                        <option>Temps partiel</option>
                    </select>
                </div>

                <div class="col-12 text-end mt-3">
                    <button type="submit" class="btn btn-primary btn-modern">
                        Rechercher
                    </button>
                </div>

            </div>
        </form>
    </div>
    

    <!-- 📄 Liste des jobs -->
    <div class="results-bar">
        <!-- Sélecteur nombre d'éléments -->
        <div class="d-flex align-items-center results">
            <label class="me-2 mb-0">Afficher :</label>
                    <form method="get" class="d-inline">
                            <select class="form-select form-select-sm" style="width: 80px;" name="pageSize" onchange="this.form.submit()">
                                @foreach (var size in new int[] {10, 25, 50})
                                {
                                    if (size == Model.PageSize)
                                    {
                                        <option value="@size" selected>@size</option>
                                    }
                                    else
                                    {
                                        <option value="@size">@size</option>
                                    }
                                }
                            </select>
                            <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                    </form>
                
        </div>

        <h6 class="mb-0">
            Page <strong>@Model.CurrentPage</strong> sur <strong>@Model.TotalPages</strong>
        </h6>
        <h6 class="mb-0">
            <strong>@Model.TotalItems</strong> résultat(s)
        </h6>
    </div>


    
    <div class="row g-4">
        @foreach (var annonce in Model.Annonces)
        {
            <div class="col-md-4">
                <div class="card-modern h-100 p-3 position-relative">
                    <span class="badge-custom-@(annonce.TypeEmploi?.Libelle == "Temps plein" ? "success" : "warning") badge-top-right">
                        @(annonce.TypeEmploi?.Libelle ?? "Non précisé")
                    </span>

                    <div class="job-card-title">@annonce.Titre</div>
                    <div class="job-entity">
                        <i class="bi bi-building"></i> @annonce.Entite?.Nom
                    </div>
                    <div class="job-location mb-2">
                        @annonce.LieuPoste - @(@annonce.TypeContrat?.Libelle ?? "Non précisé")
                    </div>
                    <p>@annonce.Description</p>
                    <div class="job-footer d-flex justify-content-between align-items-center mt-3">
                        <div class="job-date"><i class="bi bi-clock"></i> @annonce.DateLimiteDepotDossier.ToString("dd/MM/yyyy")</div>
                        <a href="@Url.Action("Details", "Annonces", new { id = annonce.Id })" 
                           class="btn btn-outline-primary btn-modern">
                            Voir l’offre
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    
    <!-- PAGINATION + SELECT ITEMS PER PAGE -->
    <div class="d-flex justify-content-end mt-4">
        <ul class="pagination pagination-circle mb-0">
            <!-- Bouton page précédente -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage - 1 })">‹</a>
            </li>

            <!-- Pages numérotées -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { currentPage = i })">@i</a>
                </li>
            }

            <!-- Bouton page suivante -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage + 1 })">›</a>
            </li>
        </ul>
    </div>

    
    <!-- Toast erreur -->
    <div id="toast-error" class="toast-error">
        <i class="bi bi-exclamation-triangle"></i>
        Veuillez vous connecter pour voir cette offre
    </div>
</div>
<script>
    function showErrorToast(message) {
        const toast = document.getElementById('toast-error');
        toast.innerHTML = `<i class="bi bi-exclamation-triangle"></i> ${message}`;
        toast.classList.add('show');

        setTimeout(() => {
            toast.classList.remove('show');
        }, 3000);
    }
</script>



