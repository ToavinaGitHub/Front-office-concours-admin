@model List<Front_Office_Concours_Admin.Models.AnnonceElasticSearchResult>

@{
ViewData["Title"] = "Recherche d'emploi";
}

<link rel="stylesheet" href="~/css/annonces.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container mt-4">

    <!-- 🔍 Formulaire de recherche -->
    <div class="search-card mb-3">
        <form method="get">
            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Titre du poste</label>
                    <input class="form-control" name="title"
                           placeholder="Ex: Développeur, Comptable..."
                           value="@ViewBag.TitleFilter" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Lieu</label>
                    <input class="form-control" name="location"
                           placeholder="Ex: Antananarivo, Tamatave"
                           value="@ViewBag.LocationFilter" />
                </div>

                <!-- TYPE DE CONTRAT -->
                @{
                var typeContratOptions = new[]
                {
                "CDI", "CDD", "Stage", "Alternance", "Freelance", "Intérim"
                };
                }

                <div class="col-md-4">
                    <label class="form-label">Type de contrat</label>
                    <select class="form-select" name="typeContrat">
                        <option value="">Tous</option>

                        @foreach (var tc in ViewBag.allTypeContrat)
                        {
                            if (ViewBag.TypeContratFilter != null && ViewBag.TypeContratFilter == tc.Id)
                            {
                                <option value="@tc.Id" selected>@tc.Libelle</option>
                            }
                            else
                            {
                                <option value="@tc.Id">@tc.Libelle</option>
                            }
                        }
                    </select>

                </div>

                <!-- TYPE D'EMPLOI -->
                @{
                var typeEmploiOptions = new[]
                {
                "Temps plein",
                "Temps partiel",
                "Télétravail",
                "Hybride",
                "Mission temporaire",
                "Consultant"
                };
                }

                <div class="col-md-4">
                    <label class="form-label">Type d’emploi</label>
                    <select class="form-select" name="horaire">
                        <option value="">Tous</option>

                        @foreach (var te in ViewBag.allTypeEmploi)
                        {
                            if (ViewBag.HoraireFilter != null && ViewBag.HoraireFilter == te.Id)
                            {
                                <option value="@te.Id" selected>@te.Libelle</option>
                            }
                            else
                            {
                                <option value="@te.Id">@te.Libelle</option>
                            }
                        }
                    </select>

                </div>

                <div class="col-12 text-end mt-3">
                    <button type="submit" class="btn btn-primary btn-modern">
                        Rechercher
                    </button>
                </div>

            </div>
        </form>
    </div>

    <!-- 📄 Résultats -->
    @if (Model != null && Model.Any())
    {
    <div class="row g-4">
        @foreach (var annonce in Model)
        {
        <div class="col-md-4">
            <div class="card-modern h-100 p-3 position-relative">

                @{
                string badgeClass = annonce.TypeEmploiId switch
                {
                1 => "badge-custom-success",
                2 => "badge-custom-primary",
                3 => "badge-custom-info",
                4 => "badge-custom-warning",
                5 => "badge-custom-secondary",
                6 => "badge-custom-danger",
                _ => "badge-custom-light"
                };
                }

                <span class="@badgeClass badge-top-right">
                            @annonce.TypeEmploi
                        </span>

                <div class="job-card-title">@annonce.Titre</div>

                <div class="job-entity">
                    <i class="bi bi-building"></i> @annonce.EntiteNom
                </div>

                <div class="job-location mb-2">
                    @annonce.Lieu - @annonce.TypeContrat
                </div>

                <p>@annonce.Description</p>

                <div class="job-footer d-flex justify-content-between align-items-center mt-3">
                    <div class="job-date">
                        <i class="bi bi-clock"></i>
                        @annonce.DatePublication.ToString("dd/MM/yyyy")
                    </div>

                    <a href="@Url.Action("Details", "Annonces", new { id = annonce.Id })"
                       class="btn btn-outline-primary btn-modern">
                        Voir l’offre
                    </a>
                </div>
            </div>
        </div>
        }
    </div>
    }
    else
    {
    <div class="alert alert-warning text-center">
        Aucun résultat trouvé.
    </div>
    }

    <div id="toast-error" class="toast-error">
        <i class="bi bi-exclamation-triangle"></i>
        Veuillez vous connecter pour voir cette offre
    </div>
</div>

<script>
    function showErrorToast(message) {
        const toast = document.getElementById('toast-error');
        toast.innerHTML = `<i class="bi bi-exclamation-triangle"></i> ${message}`;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 3000);
    }
</script>
