@{
    ViewData["Title"] = "Recherche d'emploi";
}

<link rel="stylesheet" href="~/css/annonces.css" asp-append-version="true" />
<!-- Bootstrap Icons pour la flèche -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container mt-4">
    
    <!-- 🔍 Formulaire de recherche -->
    <div class="search-card mb-1">
        <form method="get">
            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Titre du poste</label>
                    <input class="form-control" name="title" placeholder="Ex: Développeur, Comptable..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Lieu</label>
                    <input class="form-control" name="location" placeholder="Ex: Antananarivo, Tamatave" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Type de contrat</label>
                    <select class="form-select" name="typeContrat">
                        <option value="">Tous</option>
                        <option>CDI</option>
                        <option>CDD</option>
                        <option>Stage</option>
                        <option>Freelance</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Diplôme requis</label>
                    <select class="form-select" name="diplome">
                        <option value="">Tous</option>
                        <option>CEPE</option>
                        <option>BEPC</option>
                        <option>BACC</option>
                        <option>Licence</option>
                        <option>Master</option>
                        <option>Doctorat</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Durée de travail</label>
                    <select class="form-select" name="horaire">
                        <option value="">Tous</option>
                        <option>Temps plein</option>
                        <option>Temps partiel</option>
                    </select>
                </div>

                <div class="col-12 text-end mt-3">
                    <button type="submit" class="btn btn-primary btn-modern">
                        Rechercher
                    </button>
                </div>

            </div>
        </form>
    </div>
    

    <!-- 📄 Liste des jobs -->
    <div class="results-bar">
        <!-- Sélecteur nombre d'éléments -->
        <div class="d-flex align-items-center results">
            <label class="me-2 mb-0">Afficher :</label>
            <select class="form-select form-select-sm" style="width: 80px;" name="pageSize">
                <option value="6" selected>6</option>
                <option value="9">9</option>
                <option value="12">12</option>
            </select>
        </div>

        <h6 class="mb-0">Page <strong>1</strong> sur <strong>3</strong></h6>
        <h6 class="mb-0"><strong>12</strong> résultats</h6>
    </div>

    
    <div class="row g-4">

        <!-- JOB 1 -->
        <div class="col-md-4">
            <div class="card-modern h-100 p-3 position-relative">
                <span class="badge-custom-success badge-top-right">Temps plein</span>

                <div class="job-card-title">Développeur Full Stack</div>
                <div class="job-entity">
                    <i class="bi bi-building"></i> Ministère de l’Éducation
                </div>
                <div class="job-location mb-2">Antananarivo - CDI</div>
