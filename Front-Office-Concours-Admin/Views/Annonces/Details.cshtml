@{
    ViewData["Title"] = "Détails du poste";
}

<link rel="stylesheet" href="~/css/details_annonces.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- MODAL POSTULER -->
<div id="applyModal" class="apply-modal">
    <div class="apply-modal-content">

        <!-- Header -->
        <div class="apply-modal-header">
            <h5>Postuler au poste</h5>
            <button class="close-modal" onclick="closeApplyModal()">×</button>
        </div>

        <!-- Body -->
        <div class="apply-modal-body">

            <div class="apply-wrapper">

                <!-- GAUCHE : résumé poste -->
                <div class="apply-summary">
                    <p><strong>Développeur Full Stack</strong></p>
                    <p><i class="bi bi-building"></i> Ministère de l’Éducation</p>
                    <p><i class="bi bi-geo-alt"></i> Antananarivo</p>
                    <p><i class="bi bi-briefcase"></i> CDI – Temps plein</p>
                    <p><i class="bi bi-calendar-event"></i> Limite : 20/12/2025</p>
                </div>

                <!-- DROITE : formulaire -->
                <div class="apply-form">

                    <!-- STEP 1 : Informations personnelles -->
                    <!-- STEP 1 -->
                    <div class="form-step active">
                        <h5>Informations personnelles</h5>

                        <div class="mb-3">
                            <label class="form-label">Nom</label>
                            <input class="form-control">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Prénom</label>
                            <input class="form-control">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Téléphone</label>
                            <input class="form-control">
                        </div>
                    </div>


                    <!-- STEP 2 : Profil professionnel (Oui/Non) -->
                    <div class="form-step">
                        <h5>Profil professionnel</h5>

                        <div class="mb-3">
                            <label class="form-label">Licence</label><br>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="licence" value="oui">
                                <label class="form-check-label">Oui</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="licence" value="non">
                                <label class="form-check-label">Non</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Master</label><br>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="master" value="oui">
                                <label class="form-check-label">Oui</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="master" value="non">
                                <label class="form-check-label">Non</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Logé à Tana</label><br>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="doctorat" value="oui">
                                <label class="form-check-label">Oui</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="doctorat" value="non">
                                <label class="form-check-label">Non</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">+2 ans Expérience</label><br>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="experience" value="oui">
                                <label class="form-check-label">Oui</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="experience" value="non">
                                <label class="form-check-label">Non</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dispo de suite</label><br>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="competences" value="oui">
                                <label class="form-check-label">Oui</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="competences" value="non">
                                <label class="form-check-label">Non</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Véhiculé</label><br>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="competences" value="oui">
                                <label class="form-check-label">Oui</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="competences" value="non">
                                <label class="form-check-label">Non</label>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 3 : Documents -->
                    <div class="form-step">
                        <h5>Documents</h5>

                        <label class="form-label">CV (PDF)</label>
                        <input type="file" class="form-control mb-3">

                        <label class="form-label">Lettre de motivation</label>
                        <textarea class="form-control"></textarea>
                    </div>

                    <!-- Navigation fixe en bas du modal -->
                    <div class="form-navigation">
                        <button class="btn btn-outline-secondary btn-modern"
                                id="prevBtn"
                                onclick="nextPrev(-1)">
                            Précédent
                        </button>

                        <button class="btn btn-primary btn-modern"
                                id="nextBtn"
                                onclick="nextPrev(1)">
                            Suivant
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


<div class="container mt-4">

    <!-- Bouton retour -->
    <a href="/Annonces" class="btn btn-link mb-3">
        ← Retour aux offres
    </a>

    <div class="details-card">

        <div class="details-header">
            <h2 class="details-title">Développeur Full Stack</h2>
            <span class="badge-custom-success">Temps plein</span>
        </div>

        <div class="details-meta">
            <div><i class="bi bi-building"></i> Ministère de l’Éducation</div>
            <div><i class="bi bi-geo-alt"></i> Antananarivo</div>
            <div><i class="bi bi-briefcase"></i> CDI</div>
            <div><i class="bi bi-clock"></i> Publié le 10/12/2025</div>
        </div>

        <hr />

        <h5>Description du poste</h5>
        <p>
            Rejoignez une équipe dynamique pour développer des applications web modernes.
            Vous participerez à la conception, au développement et à la maintenance
            des systèmes informatiques du ministère.
        </p>

        <h5>Profil recherché</h5>
        <ul>
            <li>Licence ou Master en informatique</li>
            <li>Expérience en développement web</li>
            <li>Maîtrise de C#, ASP.NET, JavaScript</li>
        </ul>

        <h5>Conditions</h5>
        <ul>
            <li>Type de contrat : CDI</li>
            <li>Horaire : Temps plein</li>
            <li>Lieu : Antananarivo</li>
        </ul>

        <div class="details-actions">
            <div class="deadline">
                <i class="bi bi-calendar-event"></i>
                Date limite de dépôt de dossier :
                <strong class="deadline-text">20/12/2025</strong>
            </div>

            <a onclick="openApplyModal()" class="btn btn-primary btn-modern">
                Postuler
            </a>
        </div>


    </div>
</div>

<script>
    function openApplyModal() {
        document.getElementById("applyModal").classList.add("show");
        document.body.style.overflow = "hidden";
    }

    function closeApplyModal() {
        document.getElementById("applyModal").classList.remove("show");
        document.body.style.overflow = "";
    }

    let currentStep = 0;
    const steps = document.querySelectorAll(".form-step");

    function showStep(step) {
        steps.forEach((s, i) => s.classList.toggle("active", i === step));
        document.getElementById("prevBtn").style.display = step === 0 ? "none" : "inline-block";
        document.getElementById("nextBtn").innerText =
            step === steps.length - 1 ? "Envoyer" : "Suivant";
    }

    function nextPrev(n) {
        if (currentStep + n >= steps.length) {
            alert("Candidature envoyée !");
            closeApplyModal();
            return;
        }
        currentStep += n;
        showStep(currentStep);
    }

    showStep(currentStep);
</script>
