@model Front_Office_Concours_Admin.Models.DetailsAnnonceResponse
@{
    ViewData["Title"] = "Détails du poste";
    bool isAlreadyApply = ViewBag.IsAlreadyApply ?? false;
    
}

<link rel="stylesheet" href="~/css/details_annonces.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


<div aria-live="polite" aria-atomic="true" class="position-relative">
    <div class="toast-container position-fixed top-0 end-0 p-3">

        <!-- Erreur -->
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        @ViewBag.ErrorMessage
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

        <!-- Succès -->
        @{
            var successMessage = TempData["SuccessMessage"] as string;
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        @successMessage
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

    </div>
</div>

<!-- MODAL POSTULER -->
<div id="applyModal" class="apply-modal">
    <div class="apply-modal-content">

        <!-- Header -->
        <div class="apply-modal-header">
            <h5>Postuler au poste</h5>
            <button class="close-modal" onclick="closeApplyModal()">×</button>
        </div>

        <!-- Body -->
        <div class="apply-modal-body">

            <div class="apply-wrapper">
                <div class="apply-summary">
                    <p><strong>@Model.TitrePoste</strong></p>
                    <p><i class="bi bi-building"></i>@Model.NomEntite</p>
                    <p><i class="bi bi-geo-alt"></i>@Model.LieuPoste</p>
                    <p><i class="bi bi-briefcase"></i> @Model.TypeContrat – @Model.TypeEmploi</p>
                    <p><i class="bi bi-calendar-event"></i> Limite :@Model.DateLimiteDepotDossier.ToString("dd/MM/yyyy")</p>
                </div>

                <!-- DROITE : formulaire -->
                <div class="apply-form">

                    <form asp-action="CreateCandidature" method="post" enctype="multipart/form-data" id="applyForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AnnonceId" value="@Model.Annonce_ID" />

                        <!-- STEP 1 : Profil professionnel -->
                        <div class="form-step active">
                            <h5>Profil professionnel</h5>

                            @for (int i = 0; i < Model.Exigences.Count; i++)
                            {
                                var exigence = Model.Exigences[i];

                                <div class="mb-3">
                                    <input type="hidden" name="DetailsCandidature[@i].ExigenceId" value="@exigence.Id" />

                                    <label class="form-label @(exigence.IsObligatoire ? "text-danger fw-bold" : "")">
                                        @exigence.Libelle
                                        @if (exigence.IsObligatoire)
                                        {
                                            <span class="text-danger">*</span>
                                        }
                                    </label>

                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio"
                                               name="DetailsCandidature[@i].Valeur" value="true">
                                        <label class="form-check-label">Oui</label>
                                    </div>

                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio"
                                               name="DetailsCandidature[@i].Valeur" value="false" checked>
                                        <label class="form-check-label">Non</label>
                                    </div>

                                    @if (exigence.NeedPieceJustificative)
                                    {
                                        <input type="file"
                                               class="form-control mt-2"
                                               name="DetailsCandidature[@i].PieceFile"/>
                                    }
                                </div>
                            }


                            <div class="form-navigation text-end">
                                <button type="button" class="btn btn-primary" onclick="nextPrev(1)">Suivant</button>
                            </div>
                        </div>

                        <!-- STEP 2 : Documents -->
                        <div class="form-step">
                            <h5>Documents</h5>

                            <label class="form-label">CV (PDF)</label>
                            <input type="file" class="form-control mb-3" name="CVFile" required>

                            <label class="form-label">Lettre de motivation</label>
                            <input type="file" class="form-control mb-3" name="LMFile" required>

                            <div class="form-navigation">
                                <button type="button" class="btn btn-outline-secondary" onclick="nextPrev(-1)">Précédent</button>
                                <button type="submit" class="btn btn-primary">Soumettre</button>
                            </div>
                        </div>
                    </form>


                </div>
            </div>

        </div>
    </div>
</div>


<div class="container mt-4">

    <!-- Bouton retour -->
    <a href="/Annonces" class="btn btn-link mb-3">
        ← Retour aux offres
    </a>

    <div class="details-card">

        <div class="details-header">
            <h2 class="details-title">@Model.TitrePoste</h2>
            @{
                string badgeClass = @Model.TypeEmploi_ID switch
                {
                    1 => "badge-custom-success",      // Temps plein
                    2 => "badge-custom-primary",      // Temps partiel
                    3 => "badge-custom-info",         // Télétravail
                    4 => "badge-custom-warning",      // Hybride
                    5 => "badge-custom-secondary",    // Mission temporaire
                    6 => "badge-custom-danger",       // Consultant
                    _ => "badge-custom-light"         // Non précisé
                };
            }
            <span class="@badgeClass badge-top-right">
                @(@Model.TypeEmploi ?? "Non précisé")
            </span>
        </div>

        <div class="details-meta">
            <div><i class="bi bi-building"></i> @Model.NomEntite</div>
            <div><i class="bi bi-geo-alt"></i> @Model.LieuPoste</div>
            <div><i class="bi bi-briefcase"></i> @Model.TypeContrat</div>
            <div><i class="bi bi-clock"></i> Publié le @Model.DateCreationPoste.ToString("dd/MM/yyyy")</div>
        </div>

        <hr />

        <h5>Description du poste</h5>
        <p>@Model.PosteDescription</p>
        
        <h5>Tâches principales</h5>
        <ul>
            @foreach(var tache in Model.taches)
            {
                <li>@tache</li>
            }
        </ul>

        <h5>Profil recherché</h5>
        <ul>
            @foreach(var ex in Model.Exigences)
            {
                <li>@ex.Libelle</li>
            }
        </ul>

        <h5>Conditions</h5>
        <ul>
            <li>Type de contrat : @Model.TypeContrat</li>
            <li>Horaire : @Model.TypeEmploi</li>
            <li>Lieu : @Model.LieuPoste</li>
        </ul>

        <div class="details-actions">
            <div class="deadline">
                <i class="bi bi-calendar-event"></i>
                Date limite de dépôt de dossier :
                <strong class="deadline-text">@Model.DateLimiteDepotDossier.ToString("dd/MM/yyyy")</strong>
            </div>

            @if (isAlreadyApply)
            {
                <span class="d-inline-block" tabindex="0"
                      data-bs-toggle="tooltip"
                      data-bs-placement="top"
                      title="Vous avez déjà postulé à cette annonce">
                    <button class="btn btn-secondary btn-modern" disabled>
                        Déjà postulé
                    </button>
                </span>
            }
            else
            {
                <a onclick="openApplyModal()"
                   class="btn btn-primary btn-modern">
                    Postuler
                </a>
            }
        </div>


    </div>
</div>

<script>
    function openApplyModal() {
        document.getElementById("applyModal").classList.add("show");
        document.body.style.overflow = "hidden";
    }

    function closeApplyModal() {
        document.getElementById("applyModal").classList.remove("show");
        document.body.style.overflow = "";
    }

    let currentStep = 0;
    const steps = document.querySelectorAll(".form-step");

    function showStep(step) {
        steps.forEach((s, i) => s.classList.toggle("active", i === step));
        document.getElementById("prevBtn").style.display = step === 0 ? "none" : "inline-block";
        document.getElementById("nextBtn").innerText =
            step === steps.length - 1 ? "Envoyer" : "Suivant";
    }

    function nextPrev(n) {
        if (currentStep + n >= steps.length) {
            alert("Candidature envoyée !");
            closeApplyModal();
            return;
        }
        currentStep += n;
        showStep(currentStep);
    }

    showStep(currentStep);
</script>
