@{
    ViewData["Title"] = "Postuler";
}

<link rel="stylesheet" href="~/css/apply.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="apply-wrapper">

        <!-- 🟦 COLONNE GAUCHE : RÉSUMÉ POSTE (25%) -->
        <div class="apply-summary">
            <h5 class="mb-3">Résumé du poste</h5>

            <div class="summary-item">
                <strong>Développeur Full Stack</strong>
            </div>

            <div class="summary-item">
                <i class="bi bi-building"></i>
                Ministère de l’Éducation
            </div>

            <div class="summary-item">
                <i class="bi bi-geo-alt"></i>
                Antananarivo
            </div>

            <div class="summary-item">
                <i class="bi bi-briefcase"></i>
                CDI – Temps plein
            </div>

            <div class="summary-item">
                <i class="bi bi-calendar-event"></i>
                Date limite : 20/12/2025
            </div>
        </div>

        <!-- 🟨 COLONNE DROITE : FORMULAIRE (75%) -->
        <div class="apply-form">

            <!-- STEP 1 -->
            <div class="form-step active">
                <h4>Informations personnelles</h4>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Prénom</label>
                        <input class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Téléphone</label>
                        <input class="form-control" />
                    </div>
                </div>
            </div>

            <!-- STEP 2 -->
            <div class="form-step">
                <h4>Profil professionnel</h4>

                <div class="mb-3">
                    <label class="form-label">Diplôme</label>
                    <select class="form-select">
                        <option>Licence</option>
                        <option>Master</option>
                        <option>Doctorat</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Années d’expérience</label>
                    <input type="number" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Compétences</label>
                    <textarea class="form-control" rows="3"></textarea>
                </div>
            </div>

            <!-- STEP 3 -->
            <div class="form-step">
                <h4>Documents</h4>

                <div class="mb-3">
                    <label class="form-label">CV (PDF)</label>
                    <input type="file" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Lettre de motivation</label>
                    <textarea class="form-control" rows="4"></textarea>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="form-navigation">
                <button class="btn btn-outline-secondary btn-modern" id="prevBtn" onclick="nextPrev(-1)">
                    Précédent
                </button>

                <button class="btn btn-primary btn-modern" id="nextBtn" onclick="nextPrev(1)">
                    Suivant
                </button>
            </div>

        </div>
    </div>
</div>
<script>
    let currentStep = 0;
    const steps = document.querySelectorAll(".form-step");

    function showStep(step) {
        steps.forEach((s, i) => s.classList.toggle("active", i === step));
        document.getElementById("prevBtn").style.display = step === 0 ? "none" : "inline-block";
        document.getElementById("nextBtn").innerText = step === steps.length - 1 ? "Envoyer" : "Suivant";
    }

    function nextPrev(n) {
        if (currentStep + n >= steps.length) {
            alert("Candidature envoyée !");
            return;
        }
        currentStep += n;
        showStep(currentStep);
    }

    showStep(currentStep);
</script>
