@model List<Front_Office_Concours_Admin.Models.Candidature>

@{
    ViewData["Title"] = "Mes candidatures";
    var keyword = ViewData["Keyword"]?.ToString() ?? "";
    var typeContrat = ViewData["TypeContrat"]?.ToString() ?? "";
    int pageNumber = (int)ViewData["PageNumber"];
    int pageSize = (int)ViewData["PageSize"];
    int totalCount = (int)ViewData["TotalCount"];
    int totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
}

<div class="container mt-4">

    <!-- Formulaire recherche -->
    <div class="search-card mb-3 row">
        <form method="get">
            <div class="row">
                <div class="col-md-5 filter-col">
                    <input class="form-control" name="keyword" placeholder="Recherche par poste, lieu..."
                           value="@keyword" />
                </div>

                <div class="col-md-5 filter-col">
                    <select class="form-select" name="typeContrat">
                        <option value="">Tous</option>
                        @{
                        var typeContrats = ViewBag.TypeContrats as List<Front_Office_Concours_Admin.Models.TypeContrat>;
                        foreach (var tc in typeContrats)
                        {
                        if (tc.Id == (ViewData["TypeContratFilter"] as int?))
                        {
                        <option value="@tc.Id" selected>@tc.Libelle</option>
                        }
                        else
                        {
                        <option value="@tc.Id">@tc.Libelle</option>
                        }
                        }
                        }
                    </select>
                </div>


                <div class="col-md-2 filter-col">
                    <button type="submit" class="btn btn-primary btn-modern">Rechercher</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Tableau candidatures -->
    <div class="card mt-4">
        <div class="table-responsive">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-briefcase fs-1 text-muted"></i>
                    <p class="mt-3 mb-1 fw-semibold">Aucune candidature disponible</p>
                    <p class="text-muted">
                        Trouvez des postes 
                        <a href="/" class="text-decoration-none fw-semibold">ici</a>
                    </p>
                </div>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Poste</th>
                            <th>Entreprise</th>
                            <th>Lieu</th>
                            <th>Type</th>
                            <th>Date de candidature</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td><strong>@c.Annonce.Titre</strong></td>
                                <td>@c.Annonce.Entite.Nom</td>
                                <td>@c.Annonce.LieuPoste</td>
                                <td>
                                    @{
                                        string badgeClassTypeContrat = c.Annonce.TypeContrat.Id switch
                                        {
                                            1 => "bg-primary",
                                            2 => "bg-success",
                                            3 => "bg-warning text-dark",
                                            4 => "bg-info text-dark",
                                            5 => "bg-secondary",
                                            6 => "bg-danger",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClassTypeContrat">
                                        @c.Annonce.TypeContrat.Libelle
                                    </span>
                                </td>
                                <td>@c.DateCreation.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        string badgeClass = c.StatutCandidature.Id switch
                                        {
                                            1 => "bg-warning text-dark",
                                            2 => "bg-warning text-light",
                                            3 => "bg-success",
                                            _ => "bg-danger"
                                        };
                                    }
                                    <span class="badge @badgeClass">
                                        @c.StatutCandidature.Libelle
                                    </span>
                                </td>
                                <td>
                                    <a href="/Candidature/Details/@c.Id"
                                       class="arrow-action"
                                       data-bs-toggle="tooltip"
                                       title="Aller au détail">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>


    <!-- Pagination -->
    <nav class="d-flex justify-content-end mt-3">
        <ul class="pagination pagination-circle">
            <li class="page-item @(pageNumber==1?"disabled":"")">
                <a class="page-link" href="?keyword=@keyword&typeContrat=@typeContrat&pageNumber=@(pageNumber-1)&pageSize=@pageSize">‹</a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i==pageNumber?"active":"")">
                    <a class="page-link" href="?keyword=@keyword&typeContrat=@typeContrat&pageNumber=@i&pageSize=@pageSize">@i</a>
                </li>
            }

            <li class="page-item @(pageNumber==totalPages?"disabled":"")">
                <a class="page-link" href="?keyword=@keyword&typeContrat=@typeContrat&pageNumber=@(pageNumber+1)&pageSize=@pageSize">›</a>
            </li>
        </ul>
    </nav>

</div>
