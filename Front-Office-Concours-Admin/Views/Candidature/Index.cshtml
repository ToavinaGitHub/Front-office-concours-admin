@{
    ViewData["Title"] = "Recherche d'emploi";
}

<link rel="stylesheet" href="~/css/annonces.css"/>
<link rel="stylesheet" href="~/css/candidatures.css" asp-append-version="true" />
<!-- Bootstrap Icons pour la flèche -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container mt-4">
    
    <!-- 🔍 Formulaire de recherche -->
    <div class="search-card mb-1 row">
        <form method="get">
            <div class="row">
                <div class="col-md-5 filter-col">
                    <input class="form-control" name="location" placeholder="Recherche par poste,lieu,type,date,..."/>
                </div>

                <div class="col-md-5 filter-col">
                    <select class="form-select" name="typeContrat">
                        <option value="">Tous</option>
                        <option>CDI</option>
                        <option>CDD</option>
                        <option>Stage</option>
                        <option>Freelance</option>
                    </select>
                </div>
                
                <div class="col-md-2 filter-col">
                    <button type="submit" class="btn btn-primary btn-modern">
                        Rechercher
                    </button>
                </div>

            </div>
        </form>
    </div>
    

    <!-- 📄 Liste des jobs -->
    <div class="results-bar">
        <!-- Sélecteur nombre d'éléments -->
        <div class="d-flex align-items-center results">
            <label class="me-2 mb-0">Afficher :</label>
            <select class="form-select form-select-sm" style="width: 80px;" name="pageSize">
                <option value="6" selected>6</option>
                <option value="9">9</option>
                <option value="12">12</option>
            </select>
        </div>

        <h6 class="mb-0">Page <strong>1</strong> sur <strong>3</strong></h6>
        <h6 class="mb-0"><strong>12</strong> résultats</h6>
    </div>
    
    <div class="card mt-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table">
                <tr>
                    <th>Poste</th>
                    <th>Entreprise</th>
                    <th>Lieu</th>
                    <th>Type</th>
                    <th>Date de candidature</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td><strong>Développeur Web</strong></td>
                    <td>Tech Solutions</td>
                    <td>Antananarivo</td>
                    <td>
                        <span class="badge bg-info">CDI</span>
                    </td>
                    <td>05/12/2025</td>
                    <td>
                        <span class="badge bg-warning text-dark">En attente</span>
                    </td>
                    <td>
                        <span
                            class="arrow-action"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Aller au détail">
                            <a href="/Candidature/Details/1">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </span>
                    </td>
                </tr>

                <tr>
                    <td><strong>Comptable Junior</strong></td>
                    <td>Finance Plus</td>
                    <td>Tamatave</td>
                    <td>
                        <span class="badge bg-primary">CDD</span>
                    </td>
                    <td>28/11/2025</td>
                    <td>
                        <span class="badge bg-success">Accepté</span>
                    </td>
                    <td>
                        <span
                            class="arrow-action"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Aller au détail"
                        >
                            <a href="/Candidature/Details/1">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </span>
                    </td>
                </tr>

                <tr>
                    <td><strong>Assistant RH</strong></td>
                    <td>HumanCorp</td>
                    <td>Fianarantsoa</td>
                    <td>
                        <span class="badge bg-secondary">Stage</span>
                    </td>
                    <td>15/11/2025</td>
                    <td>
                        <span class="badge bg-danger">Refusé</span>
                    </td>
                    <td>
                        <span
                            class="arrow-action"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Aller au détail"
                        >
                            <a href="/Candidature/Details/1">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </span>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- PAGINATION + SELECT ITEMS PER PAGE -->
    <div class="d-flex justify-content-end mt-4">
        <ul class="pagination pagination-circle mb-0">
            <li class="page-item disabled"><a class="page-link">‹</a></li>
            <li class="page-item active"><a class="page-link">1</a></li>
            <li class="page-item"><a class="page-link">2</a></li>
            <li class="page-item"><a class="page-link">3</a></li>
            <li class="page-item"><a class="page-link">›</a></li>
        </ul>
    </div>
    
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tooltipTriggerList = [].slice.call(
            document.querySelectorAll('[data-bs-toggle="tooltip"]')
        )

        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    })
</script>




