@{
    ViewData["Title"] = "Détails du poste";
}

<link rel="stylesheet" href="~/css/details_annonces.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/details_candidature.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container mt-4">

    <!-- Bouton retour -->
    <a href="/Candidature" class="btn btn-link mb-3">
        ← Retour aux candidatures
    </a>

    <div class="details-card">

        <div class="details-header">
            <h2 class="details-title">Développeur Full Stack</h2>
            <span class="badge-custom-success">Temps plein</span>
        </div>

        <div class="details-meta">
            <div><i class="bi bi-building"></i> Ministère de l’Éducation</div>
            <div><i class="bi bi-geo-alt"></i> Antananarivo</div>
            <div><i class="bi bi-briefcase"></i> CDI</div>
            <div><i class="bi bi-clock"></i> Publié le 10/12/2025</div>
        </div>

        <hr />

        <h5>Description du poste</h5>
        <p>
            Rejoignez une équipe dynamique pour développer des applications web modernes.
            Vous participerez à la conception, au développement et à la maintenance
            des systèmes informatiques du ministère.
        </p>

        <h5>Profil recherché</h5>
        <ul>
            <li>Licence ou Master en informatique</li>
            <li>Expérience en développement web</li>
            <li>Maîtrise de C#, ASP.NET, JavaScript</li>
        </ul>

        <h5>Conditions</h5>
        <ul>
            <li>Type de contrat : CDI</li>
            <li>Horaire : Temps plein</li>
            <li>Lieu : Antananarivo</li>
        </ul>

        <div class="details-actions">
            <div class="deadline">
                <i class="bi bi-calendar-event"></i>
                Postulé le :
                <strong class="applying-date">20/12/2025</strong>
            </div>
        </div>
    </div>
    <div class="details-card evolution">
        <hr />
        <h5>Évolution de la candidature</h5>

        <div class="timeline-container">

            <div class="timeline-step completed">
                <div class="circle">
                    <i class="bi bi-check-lg"></i>
                </div>
                <div class="label">
                    <span>Postulé</span>
                    <small>18/12/2025</small>
                </div>
            </div>

            <div class="timeline-line completed"></div>

            <div class="timeline-step completed">
                <div class="circle">
                    <i class="bi bi-check-lg"></i>
                </div>
                <div class="label">
                    <span>Validé</span>
                    <small>19/12/2025</small>
                </div>
            </div>

            <div class="timeline-line"></div>

            <div class="timeline-step active">
                <div class="circle">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="label">
                    <span>Entretien</span>
                    <small>En attente</small>
                </div>
            </div>

            <div class="timeline-line"></div>

            <div class="timeline-step">
                <div class="circle">
                    <i class="bi bi-lock"></i>
                </div>
                <div class="label">
                    <span>Décision</span>
                    <small>—</small>
                </div>
            </div>

        </div>
    </div>
</div>


